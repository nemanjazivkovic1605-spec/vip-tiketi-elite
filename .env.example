# Server-only Gemini key used by /api/generate-daily-analysis.
# Configure this in Vercel Environment Variables; never rename it to VITE_GEMINI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional primary model override. Automatic fallback order:
# gemini-3.5-flash -> gemini-2.5-flash -> gemini-2.5-flash-lite.
GEMINI_ANALYSIS_MODEL="gemini-3-flash-preview"

# Server-only sports providers for daily fixtures, picks, results and analysis enrichment.
# Set these in Vercel only. Do not expose them through VITE_ environment variables.
API_FOOTBALL_KEY="MY_API_FOOTBALL_KEY"
# Set false to skip a suspended account without blocking free fixture/result providers.
API_FOOTBALL_ENABLED="true"
API_BASKETBALL_KEY=""
FOOTBALL_DATA_API_KEY="MY_FOOTBALL_DATA_API_KEY"
THESPORTSDB_API_KEY="123"
# Optional independent bookmaker prices. Get a personal free key at https://the-odds-api.com/.
# The free starter plan has 500 credits/month; never use VITE_ODDS_API_KEY.
ODDS_API_KEY=""
# Shared daily/product discovery scans active football competitions; catalog/events cost no odds credits.
# Admin proposal mode saves at most 10 private proposals, never public tickets.
DAILY_DISCOVERY_LEAGUE_LIMIT="40"
# Quotes are cached for 5 minutes and must be no older than 15 minutes at publication.
# For an exact match/market, the highest returned fresh bookmaker price is used, never a fixed uplift.
# Optional: cache sports enrichment results for 15-60 minutes (default 30).
SPORTS_STATS_CACHE_TTL_MINUTES="30"

# Required for scheduled daily publication and result checks.
# Vercel sends this secret as a Bearer token. Missing secret denies access.
CRON_SECRET="CHANGE_ME"
DAILY_LOOKAHEAD_DAYS="3"
DAILY_FREE_PICKS="1"
DAILY_VIP_PICKS="2"
# Existing morning cron also publishes one Elite Ticket and one Safe Pick.
# Set false to pause new product publication; existing tickets still settle.
PRODUCT_TICKETS_ENABLED="true"
# Bounded pagination/prediction requests. All available leagues are eligible.
DAILY_ODDS_PAGE_LIMIT="3"
DAILY_PREDICTION_LIMIT="4"
SPORTS_API_INTERVAL_MS="6100"
WORLD_CUP_LEAGUE_ID="1"
WORLD_CUP_SEASON="2026"
WORLD_CUP_TIMEZONE="Europe/Belgrade"

# Manual public index sync safety controls. The sync command is dry-run by default.
PUBLIC_INDEX_SYNC_MAX_PLANNED_WRITES="500"
PUBLIC_INDEX_SYNC_BATCH_LIMIT="10"
PUBLIC_INDEX_SYNC_BATCH_PAUSE_MS="1000"
PUBLIC_INDEX_SYNC_MAX_RETRIES="5"
PUBLIC_INDEX_SYNC_RETRY_BASE_MS="2500"
PUBLIC_INDEX_SYNC_REQUEST_TIMEOUT_MS="30000"

# Resend email service.
# The backend route uses this key to send verification, reset, welcome, and contact emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_CONTACT_TO_EMAIL="nemanjazivkovic1605@gmail.com"
RESEND_TEMPLATE_WELCOME_ID=""
RESEND_TEMPLATE_CONTACT_ID=""

# Firebase Admin service account required for custom verification and password reset links.
FIREBASE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",...}"
# Optional local file path for explicit maintenance commands (never bundled).
FIREBASE_SERVICE_ACCOUNT_PATH=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="https://eliteviptips.com"
# Optional checkout conversion rate. Bank transfer checkout defaults to 117.20 RSD per EUR.
VITE_EUR_RSD_RATE="117.20"
# History/Stats/Home use public aggregates and paged reads, with a local/CDN snapshot fallback.
# Set false to disable only the CDN history fallback.
VITE_PUBLIC_HISTORY_SNAPSHOT_ENABLED=true

# Sports credentials belong only in API_FOOTBALL_KEY, API_BASKETBALL_KEY,
# and FOOTBALL_DATA_API_KEY above. Never put sports keys in VITE_ variables.

# true = disable legacy cached fallback. Match requests always use the server sports API.
VITE_USE_REAL_API=false

# EmailJS contact form. Create these in EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"
VITE_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="public_key_xxxxxxx"
VITE_EMAILJS_WELCOME_TEMPLATE_ID="template_welcome_xxxxxxx"

# Public footer/contact email stays support@eliteviptips.com, while submitted messages are sent to Gmail.
VITE_CONTACT_DISPLAY_EMAIL="support@eliteviptips.com"
VITE_CONTACT_TO_EMAIL="nemanjazivkovic1605@gmail.com"

# Firebase web config. Production can use these Vercel env vars; if omitted,
# the app falls back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:xxxxx:web:xxxxx"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="xxxxx"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIRESTORE_DATABASE_ID="(default)"
