{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.eliteviptips.com"
        }
      ],
      "destination": "https://eliteviptips.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/daily-picks.ts": { "maxDuration": 300 },
    "api/daily-results.ts": { "maxDuration": 300 },
    "api/fetch-daily-sports.ts": { "maxDuration": 120 },
    "api/football-data.ts": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/daily-picks",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/daily-results",
      "schedule": "30 23 * * *"
    }
  ]
}
