{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.eliteviptips.com"
        }
      ],
      "destination": "https://eliteviptips.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/world-cup-seed", "destination": "/api/world-cup?action=seed" },
    { "source": "/api/world-cup-results", "destination": "/api/world-cup?action=results" },
    { "source": "/api/football-data", "destination": "/api/football-providers?action=football-data" },
    { "source": "/api/pitch-matches", "destination": "/api/football-providers?action=pitch-matches" },
    { "source": "/api/fetch-fixture-result", "destination": "/api/football-providers?action=fetch-fixture-result" },
    { "source": "/fudbal", "destination": "/api/football-analytics?public=1&page=overview" },
    { "source": "/match-finder", "destination": "/api/football-analytics?public=1&page=finder" },
    { "source": "/fudbal/lige/:slug", "destination": "/api/football-analytics?public=1&page=league&slug=:slug" },
    { "source": "/fudbal/utakmice/:id", "destination": "/api/football-analytics?public=1&page=match&id=:id" },
    { "source": "/timovi", "destination": "/api/football-analytics?public=1&page=teams" },
    { "source": "/statistika/:slug", "destination": "/api/football-analytics?public=1&page=team&slug=:slug" },
    { "source": "/h2h", "destination": "/api/football-analytics?public=1&page=h2h" },
    { "source": "/h2h/:first/:second", "destination": "/api/football-analytics?public=1&page=pair&first=:first&second=:second" },
    { "source": "/analize-danas", "destination": "/api/football-analytics?public=1&page=today" },
    { "source": "/lige/:slug", "destination": "/api/football-analytics?public=1&page=league-alias&slug=:slug" },
    { "source": "/utakmice/:id", "destination": "/api/football-analytics?public=1&page=match-alias&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/football-analytics?public=1&page=sitemap" },
    { "source": "/sitemaps/:segment.xml", "destination": "/api/football-analytics?public=1&page=sitemap&segment=:segment" },
    { "source": "/api/public-football", "destination": "/api/football-analytics?public=1" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/:page(contact|faq|terms|bankroll-management|daily-analysis|early-information|history|stats)", "destination": "/:page.html" },
    { "source": "/:page(tickets|table|results|live-results|live|statistics|cesta-pitanja|daily-tips|dnevne-analize|dnevni-tipovi|legal|pravila-koriscenja|login|register|checkout|auth-action|dashboard|pricing|vip|vip-tips)", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },
    { "source": "/__/auth/action", "destination": "/app.html" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/api/football-analytics?public=1&page=not-found" }
  ],
  "headers": [
    { "source": "/:page(login|register|checkout|auth-action|dashboard|pricing|vip|vip-tips|app.html)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/__/auth/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "functions": {
    "api/football-analytics.ts": { "maxDuration": 240 },
    "api/daily-picks.ts": { "maxDuration": 300 },
    "api/daily-results.ts": { "maxDuration": 300 },
    "api/fetch-daily-sports.ts": { "maxDuration": 120 },
    "api/football-providers.ts": { "maxDuration": 300 },
    "api/world-cup.ts": { "maxDuration": 300 },
    "api/generate-daily-analysis.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/football-analytics?action=sync",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/daily-picks",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/daily-results",
      "schedule": "30 23 * * *"
    }
  ]
}
