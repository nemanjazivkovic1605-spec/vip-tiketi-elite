{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.eliteviptips.com"
        }
      ],
      "destination": "https://eliteviptips.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/fudbal", "destination": "/api/football-analytics?public=1&page=overview" },
    { "source": "/match-finder", "destination": "/api/football-analytics?public=1&page=finder" },
    { "source": "/fudbal/lige/:slug", "destination": "/api/football-analytics?public=1&page=league&slug=:slug" },
    { "source": "/fudbal/utakmice/:id", "destination": "/api/football-analytics?public=1&page=match&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/football-analytics?public=1&page=sitemap" },
    { "source": "/api/public-football", "destination": "/api/football-analytics?public=1" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/football-analytics.ts": { "maxDuration": 240 },
    "api/daily-picks.ts": { "maxDuration": 300 },
    "api/daily-results.ts": { "maxDuration": 300 },
    "api/fetch-daily-sports.ts": { "maxDuration": 120 },
    "api/football-data.ts": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/football-analytics?action=sync",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/daily-picks",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/daily-results",
      "schedule": "30 23 * * *"
    }
  ]
}
